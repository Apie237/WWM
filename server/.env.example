PORT=5000
NODE_ENV=development
# REQUIRED in production (the server refuses to start without them).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/wwm
# The exact browser origin(s) of the deployed frontend, scheme included, no
# trailing path. Comma-separate to allow more than one (e.g. a www alias).
# Never "*": the admin session cookie needs an explicit allowlist.
CLIENT_ORIGIN=http://localhost:5173

# Phase 10 — number of reverse-proxy hops in front of the API, so rate limits
# use the real client IP. Leave unset on Vercel (it defaults to 1 there and to
# 0 elsewhere). Set to 1 behind one proxy/load balancer; do not guess higher.
# TRUST_PROXY=

# Phase 6 — Authentication
# JWT_SECRET must be a long random string, supplied by the deployment
# platform's own environment variable mechanism in production. Never commit
# a real value here.
# Use at least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Phase 6 — one-time SUPER_ADMIN seed (npm run seed:admin). All three must be
# set for the script to run; it never creates a default admin account.
# Replace with a real name/email and a strong password before running.
ADMIN_SEED_NAME=Replace With A Name
ADMIN_SEED_EMAIL=replace@example.org
# Wrap the password in double quotes if it contains "#" (dotenv treats an unquoted # as a comment
# and would store a shorter password than the one you type at the login form).
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# --- Media uploads (Phase 9, Cloudinary) ---------------------------------
# Leave these empty to run without uploads; the admin upload control then
# shows "not configured" and the API answers 503. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: max upload size in MB (default 4; keep <= 4 on Vercel, whose
# request-body limit is about 4.5 MB).
MEDIA_MAX_UPLOAD_MB=4
